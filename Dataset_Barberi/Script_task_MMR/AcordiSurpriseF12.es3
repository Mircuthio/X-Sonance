<?xml version="1.0"?>
<Experiment xmlns:dt="urn:schemas-microsoft-com:datatypes"><General><Version><Major dt:dt="ui4">3</Major><Minor dt:dt="ui4">0</Minor><Internal dt:dt="ui4">3</Internal><Build dt:dt="ui4">82</Build><_VersionPersist dt:dt="int">300</_VersionPersist></Version></General><ExperimentObject><Guid dt:dt="string"/><Root dt:dt="string"/><Name dt:dt="string"/><Author dt:dt="string">Brandon S. Cernicky/Amy Eschman (PST)</Author><Abstract dt:dt="string">This experiment illustrates a method used to rerun error trials.

If a response is scored as incorrect (i.e., Stim.ACC = 0), the
values for that trial are used to populate a second List.  The
second List is then used to rerun error trials after all of the trials
have been run once.  The conditional allows for the re-running 
of error trials only if errors occur.

This example reruns trials only once, but could be written to rerun 
trials until answered correctly.
</Abstract><Notes dt:dt="string"></Notes><ClockGuid dt:dt="string"/><ClockIndex dt:dt="int"/><ClockScale dt:dt="r8"/><Windowed dt:dt="boolean"/><VersionMajor dt:dt="int">1</VersionMajor><VersionMinor dt:dt="int">0</VersionMinor><VersionInternal dt:dt="int">0</VersionInternal><VersionBuild dt:dt="int">284</VersionBuild><VersionAutoIncrement dt:dt="boolean">1</VersionAutoIncrement><CreationDateUtc dt:dt="dateTime">2024-12-06T15:32:57.000</CreationDateUtc><Features dt:dt="int">1073741824</Features><Devices/><Packages/><DataFile/><StartupInfo/><AdvisorModuleInstanceManager/><SlideButtonThemeManager/></ExperimentObject><StudioItems/><UserScript dt:dt="string"></UserScript><TestMode/><Doc dt:dt="string">IVeW5hMqBXkgjLNNVMAgfCsMWgClINHQLLQ/DVsFk0UsV+NYPmqvZ78XFKOTkVWUL/Il38w4IUFvO58+
